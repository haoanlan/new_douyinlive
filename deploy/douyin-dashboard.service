[Unit]
Description=抖音直播监控仪表盘 (web-dashboard.js)
Documentation=file:///opt/douyin-monitor/README.md
After=network-online.target douyin-monitor.service
Wants=network-online.target
# 仪表盘依赖守护进程的 monitor.sock，但守护进程没起来时仪表盘也要能开（看历史数据）
After=douyin-monitor.service

[Service]
Type=simple
WorkingDirectory=/opt/douyin-monitor
ExecStart=/usr/bin/node web-dashboard.js
Restart=always
RestartSec=5

# 仪表盘默认绑定 127.0.0.1:9871；对外提供服务时建议前面挂 Nginx 反代并启用 token
Environment=DASHBOARD_HOST=127.0.0.1
Environment=DASHBOARD_PORT=9871
# 生产环境务必设置访问令牌（也可写在 config.yaml 的 dashboard.token）
# Environment=DASHBOARD_TOKEN=请改成你的令牌

StandardOutput=journal
StandardError=journal
SyslogIdentifier=douyin-dashboard

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
