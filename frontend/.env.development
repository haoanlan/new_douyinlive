# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 权限/菜单来源模式：
#   frontend = 菜单与权限用前端路由配置（src/router/modules/*），本项目用这个
#   backend  = 菜单由后端 /api/v3/system/menus 返回，本项目后端没有这个接口
# 不设置会导致登录后拉取后端菜单 404，路由守卫跳转到 500 错误页（“抱歉，服务器出错了”）
VITE_ACCESS_MODE = frontend

# API 请求基础路径（开发环境设置为 / 使用代理，生产环境设置为完整后端地址）
VITE_API_URL = /

# 代理目标地址（开发环境通过 Vite 代理转发请求到此地址，解决跨域问题）
VITE_API_PROXY_URL = http://127.0.0.1:9871

# Delete console
VITE_DROP_CONSOLE = false